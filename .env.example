APP_ENV=development
API_PORT=7302

# ⚠️ 一律写 127.0.0.1，不要写 localhost：
#   本机 localhost 会优先解析到 IPv6 ::1，而 compose 端口只绑 127.0.0.1（IPv4）。
#   实测 redis 直接连接超时 2s；asyncpg/boto3 会回退但要白等一轮重试。
DATABASE_URL=postgresql+asyncpg://retouch:retouch_dev@127.0.0.1:7311/retouch
REDIS_URL=redis://127.0.0.1:7312

# 对象存储（pgsty/silo，MinIO 分支，S3 兼容）
#   宿主机用 http://127.0.0.1:7313；容器内互访用 http://minio:9000
S3_ENDPOINT=http://127.0.0.1:7313
S3_ACCESS_KEY=retouch
S3_SECRET_KEY=retouch_dev
S3_BUCKET=retouch
S3_REGION=us-east-1

# 必填：缺失时启动直接失败并打印缺失清单，不做不安全默认值兜底
JWT_SECRET=dev-only-change-me
JWT_TTL_HOURS=24

# mock 使用本地占位图，不产生任何调用费用；接真实模型时改为 dashscope（需要 Key）
IMAGE_PROVIDER=mock
DASHSCOPE_API_KEY=
# qwen-image 3.0/2.1 系列走 messages 式异步端点（DashscopeProvider 实现的契约）：
#   可选值如 qwen-image-3.0-pro / qwen-image-3.0 / qwen-image-2.1-pro / qwen-image-2.1-turbo
TEXT_TO_IMAGE_MODEL=qwen-image-3.0-pro
IMAGE_EDIT_MODEL=qwen-image-3.0-pro
# Agent 规划模型（OpenAI 兼容模式）；deepseek 系列不在百炼兼容模式默认清单里
PLANNER_MODEL=qwen-plus

# Agent 单步（M4）：必须是 **OpenAI 兼容端点**
#   百炼 = https://dashscope.aliyuncs.com/compatible-mode/v1，留空也用它
#   ⚠️ /api/v1 是 DashScope 原生 API 前缀（生图走的那条），填进来规划必 404
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
