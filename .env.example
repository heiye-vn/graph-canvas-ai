APP_ENV=development
API_PORT=7402

# 端口段：本项目占用 74xx（前端 7401 / API 7402 / PG 7411 / Redis 7412 / S3 7413-7414），
#        与参考项目 ai-picture-editor 的 73xx 段错开，两套可同时启动。
#
# ⚠️ 一律写 127.0.0.1，不要写 localhost：
#   本机 localhost 会优先解析到 IPv6 ::1，而 compose 端口只绑 127.0.0.1（IPv4）。
#   实测 redis 直接连接超时 2s；asyncpg/boto3 会回退但要白等一轮重试。
DATABASE_URL=postgresql+asyncpg://retouch:retouch_dev@127.0.0.1:7411/retouch
REDIS_URL=redis://127.0.0.1:7412

# 对象存储（pgsty/silo，MinIO 分支，S3 兼容）
#   宿主机用 http://127.0.0.1:7413；容器内互访用 http://minio:9000
S3_ENDPOINT=http://127.0.0.1:7413
S3_ACCESS_KEY=retouch
S3_SECRET_KEY=retouch_dev
S3_BUCKET=retouch
S3_REGION=us-east-1

# 必填：缺失时启动直接失败并打印缺失清单，不做不安全默认值兜底
JWT_SECRET=dev-only-change-me
JWT_TTL_HOURS=24

# ==============================================================================
# 模型 Provider 与 API 配置
# ==============================================================================
# IMAGE_PROVIDER 可选值：
#   1. mock: 使用本地 Pillow 占位色块图，不产生任何调用费用，无需 API Key
#   2. dashscope: 阿里云百炼原生 messages 生图端点（需要 DASHSCOPE_API_KEY）
#   3. openai: 第三方 OpenAI 兼容中转站（如 api.monkeycoding.club 等，需要 IMAGE_API_KEY）
IMAGE_PROVIDER=mock

# 阿里云百炼 API Key（用于 Agent 规划模型，或 IMAGE_PROVIDER=dashscope 时的生图）
DASHSCOPE_API_KEY=

# 第三方中转站生图配置（当 IMAGE_PROVIDER=openai 时使用）
IMAGE_BASE_URL=https://api.monkeycoding.club/v1
IMAGE_API_KEY=

# 生图模型名：
#   百炼可选：qwen-image-3.0-pro / qwen-image-3.0 / qwen-image-2.1-pro
#   中转站可选：gpt-image-2 / gpt-image-1 / gpt-image-2.5-flare / gemini-3-pro-image 等
TEXT_TO_IMAGE_MODEL=gpt-image-2
IMAGE_EDIT_MODEL=gpt-image-2

# Agent 单步规划模型（M4）：走 OpenAI 兼容端点
#   使用阿里云百炼作为规划模型：保持 LLM_BASE_URL 留空（默认走百炼 compatible-mode/v1）
#   PLANNER_MODEL 可选：qwen-plus / qwen-max / qwen-turbo
PLANNER_MODEL=qwen-plus
LLM_BASE_URL=
LLM_TEMPERATURE=0.0


# 选区分割（M6）：sam = rembg 的 SAM 模型（需 uv sync --extra cv）；
# circle = 纯画圆兜底；auto = 先试 SAM，失败降级画圆
MATTING_PROVIDER=auto

# 文字检测（M7 拆层）：rapidocr = cv extra 里的 rapidocr-onnxruntime；
# none = 不检测（拆层仍可用，只是没有文字层）；auto = 装了就用，异常静默降级
OCR_PROVIDER=auto

# ==============================================================================
# 可选：Langfuse 观测导出（不配 = 完全不启用，本地 trace 表照常工作）
# ==============================================================================
# 配置后，每条 trace 会旁路推送到 Langfuse（agent_traces 表仍是真相源）。
# Cloud：https://cloud.langfuse.com 注册后取 Public / Secret Key
# 自托管：LANGFUSE_HOST 填自己的地址
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com