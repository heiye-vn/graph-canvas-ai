APP_ENV=development
API_PORT=7302

# ⚠️ 一律写 127.0.0.1，不要写 localhost：
#   本机 localhost 会优先解析到 IPv6 ::1，而 compose 端口只绑 127.0.0.1（IPv4）。
#   实测 redis 直接连接超时 2s；asyncpg/boto3 会回退但要白等一轮重试。
DATABASE_URL=postgresql+asyncpg://retouch:retouch_dev@127.0.0.1:7311/retouch
REDIS_URL=redis://127.0.0.1:7312

# 对象存储（pgsty/silo，MinIO 分支，S3 兼容）
#   宿主机用 http://127.0.0.1:7313；容器内互访用 http://minio:9000
S3_ENDPOINT=http://127.0.0.1:7313
S3_ACCESS_KEY=retouch
S3_SECRET_KEY=retouch_dev
S3_BUCKET=retouch
S3_REGION=us-east-1

# 必填：缺失时启动直接失败并打印缺失清单，不做不安全默认值兜底
JWT_SECRET=dev-only-change-me
JWT_TTL_HOURS=24

# ==============================================================================
# 模型 Provider 与 API 配置
# ==============================================================================
# IMAGE_PROVIDER 可选值：
#   1. mock: 使用本地 Pillow 占位色块图，不产生任何调用费用，无需 API Key
#   2. dashscope: 阿里云百炼原生 messages 生图端点（需要 DASHSCOPE_API_KEY）
#   3. openai: 第三方 OpenAI 兼容中转站（如 api.monkeycoding.club 等，需要 IMAGE_API_KEY）
IMAGE_PROVIDER=mock

# 阿里云百炼 API Key（用于 Agent 规划模型，或 IMAGE_PROVIDER=dashscope 时的生图）
DASHSCOPE_API_KEY=

# 第三方中转站生图配置（当 IMAGE_PROVIDER=openai 时使用）
IMAGE_BASE_URL=https://api.monkeycoding.club/v1
IMAGE_API_KEY=

# 生图模型名：
#   百炼可选：qwen-image-3.0-pro / qwen-image-3.0 / qwen-image-2.1-pro
#   中转站可选：gpt-image-2 / gpt-image-1 / gpt-image-2.5-flare / gemini-3-pro-image 等
TEXT_TO_IMAGE_MODEL=gpt-image-2
IMAGE_EDIT_MODEL=gpt-image-2

# Agent 单步规划模型（M4）：走 OpenAI 兼容端点
#   使用阿里云百炼作为规划模型：保持 LLM_BASE_URL 留空（默认走百炼 compatible-mode/v1）
#   PLANNER_MODEL 可选：qwen-plus / qwen-max / qwen-turbo
PLANNER_MODEL=qwen-plus
LLM_BASE_URL=
LLM_TEMPERATURE=0.0

